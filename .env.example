BOT_TOKEN=your_telegram_bot_token_here

# Пароли инфраструктуры (используются docker-compose при подстановке)
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me

# Строки подключения для локального запуска без docker-compose.
# В compose они переопределяются и собираются из паролей выше.
DATABASE_URL=postgresql+asyncpg://lordok:change_me@localhost:5432/lordok_db
REDIS_URL=redis://:change_me@localhost:6379/0

ADMIN_IDS=123456789
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Хранилище состояний диалога: redis (по умолчанию) или memory.
# memory оставлен только для локальной отладки без redis.
FSM_STORAGE=redis
